# Copy to /opt/evelio-updating/frontend-build.env and fill in the PRODUCTION
# values. That file is untracked and must NEVER be committed — the Turnstile
# sitekey is a real, domain-locked production value.
#
#   sudo cp frontend-build.env.template /opt/evelio-updating/frontend-build.env
#   sudo chmod 600 /opt/evelio-updating/frontend-build.env
#   sudo nano /opt/evelio-updating/frontend-build.env
#
# update.sh refuses to build if either is missing, empty, or (for the sitekey)
# looks like one of Cloudflare's testing keys (1x…/2x…/3x…), which the staging
# tooling uses on purpose and which must never reach production.

# NOTE: the API is on evelio.net, NOT app.evelio.net. Caddy's app.evelio.net
# block is `root /var/www/evelio-app` plus `try_files {path} /index.html` and has
# no reverse_proxy at all, so an API base pointed there answers every call with
# index.html and a 200 — a frontend that fails in a way nothing reports as an
# error. `@api path /api/v1/*` is proxied to :8080 on evelio.net. This is also
# the app's own default in frontend/src/lib.js.
VITE_API_BASE=https://evelio.net/api/v1

# The public Turnstile SITE key. If you ever need to recover it, the deployed
# bundle in /var/www/evelio-app has it — it ships to every browser by design.
VITE_TURNSTILE_SITE_KEY=
